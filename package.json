{
  "name": "liskov-appium-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Appium + WebdriverIO E2E framework for The Economist app ePaper (Print edition) cases EP-01\u2026EP-34, iOS and Android, real data, no mocks. Standalone; reads mobile-liskov only for the L0 contract layer.",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "mocha --config .mocharc.unit.cjs",
    "test:contract": "mocha --config .mocharc.contract.cjs",
    "contract:mutations": "tsx scripts/contract-mutations.ts",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run test:contract",
    "validate": "tsx scripts/validate.ts",
    "doctor": "bash scripts/doctor.sh",
    "login": "tsx scripts/login.ts",
    "run:one": "bash scripts/run/run-one.sh",
    "run:many": "bash scripts/run/run-many.sh",
    "appium:start": "bash scripts/appium-dev.sh start",
    "appium:stop": "bash scripts/appium-dev.sh stop",
    "appium:status": "bash scripts/appium-dev.sh status",
    "leak-scan": "tsx scripts/secret-leak-scan.ts",
    "report": "allure generate allure-results -o reports/allure --clean",
    "report:open": "allure open reports/allure -p 5054",
    "flags:init": "tsx scripts/flags-init.ts",
    "register-device": "tsx scripts/register-device.ts",
    "locks": "tsx scripts/locks-doctor.ts",
    "locks:purge": "tsx scripts/locks-doctor.ts --purge-stale",
    "flake-report": "tsx scripts/flake-report.ts",
    "login-guard": "tsx scripts/login-page-guard.ts"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "dotenv": "18.0.9",
    "fast-xml-parser": "4.5.7",
    "pdfjs-dist": "4.10.38",
    "webdriverio": "9.32.0",
    "yaml": "2.9.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@wdio/allure-reporter": "9.32.0",
    "@wdio/appium-service": "9.32.0",
    "@wdio/cli": "9.32.0",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/types": "9.32.0",
    "allure-commandline": "2.46.1",
    "appium": "3.9.0",
    "eslint": "9.39.5",
    "mocha": "11.8.0",
    "pdf-lib": "1.17.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
