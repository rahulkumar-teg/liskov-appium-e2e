# liskov-appium-e2e — local .env template. PLACEHOLDERS ONLY: never put a real value in this file.
#
#   cp .env.example .env && chmod 600 .env        # .env is git-ignored; keep it 0600
#
# How the framework reads .env (src/core/dotenv.ts):
#   [A] SETTINGS keys (ConfigBase in src/core/ConfigLoader.ts + PDF_* / APPIUM_* / WDA_LOCAL_PORT) are copied into
#       process.env. A real environment variable of the same name always wins.
#   [B] Every OTHER key is treated as a SECRET: it is never put in process.env, never printed, and is read privately
#       by SecretsBroker through `env:NAME` references (config/secrets.ts, config/accounts.ts).
#   [C] Per-run knobs (device serial, specs, opt-ins …) are NOT loaded from .env — export them in the shell or pass
#       them to the runner scripts / `npm run login -- …`. They are listed at the bottom for reference only.

# =====================================================================================================
# [A] SETTINGS (non-secret). Defaults shown; uncomment to change.
# =====================================================================================================
# TARGET=android-real            # set by the wdio.<target>.conf.ts for device runs; validate reads it here. ios-real | android-real | ios-sim | android-emu | ios-cloud | android-cloud (required for MODE=run)
# ENV=stage                      # stage | prod
# MODE=run                       # run | validate
# DEVICE_ID=                     # id from config/devices.yaml
# INSTALL_MODE=none              # none (default: test the build already on the device) | auto
# APP_COMMIT=                    # git SHA; required for INSTALL_MODE=auto
# BUILD_VARIANT=economistDebug   # economistDebug | economistQaDebug
# APP_PATH=                      # prebuilt .apk/.ipa (INSTALL_MODE=auto)
# EXPECTED_APP_BUILD=
# LISKOV_BUILD_ROOT=~/liskov-appium-builds
# LISKOV_STATE_DIR=~/.liskov-appium
# LISKOV_REMOTE_URL=git@github.com:EconomistDigitalSolutions/mobile-liskov.git
# ANDROID_LOCAL_PROPERTIES=
# LISKOV_REPO=~/Documents/mobile-liskov   # read-only mobile-liskov checkout for the L0 contract layer (make contract)
# APP_BUNDLE_ID=com.economist.lamarr
# ANDROID_ACTIVITY=com.economist.liskov.feature.main.MainActivity
# IOS_TEAM_ID=YOUR_APPLE_TEAM_ID         # no default; needed by `make build KIND=ios-device`. WDA signing for runs lives in config/wda.local.json
# IOS_WDA_BUNDLE_ID=com.example.WebDriverAgentRunner   # no default; runs use updatedWDABundleId in config/wda.local.json
# COUNTRY=DK                     # ISO-3166 alpha-2
# REGIONS=DK,US,GB               # ≥2 needed for EP-19 / EP-30
# FLAG_SOURCE=auto               # auto | api | manual
# FLAGS_OVERRIDE_PATH=config/flags.override.json
# FLAGS_MAX_AGE_HOURS=24
# FLAGS_WARN_AGE_HOURS=1
# AMPLITUDE_IDS_PATH=config/amplitude-ids.json
# DEVICES_PATH=config/devices.yaml
# CLOUD_PROVIDER=                # browserstack | sauce (not used yet)
# CLOUD_TUNNEL=false
# DOWNLOAD_TIMEOUT_MS=180000
# FAILED_STATE_TIMEOUT_MS=300000
# LOCK_TTL_MS=7200000
# HEARTBEAT_MS=60000
# DEVICE_LOCK_WAIT_MS=600000
# ACCOUNT_LEASE_WAIT_MS=600000
# ALLOW_NETWORK_TOGGLE=true
# VALIDATE_RESOLVE_SECRETS=false # true ⇒ `make validate` resolves op:// refs (needs the op CLI)
# PDF_STAGING_CONTENT_IDS=YYYY_MM_DD_EU   # opt-in real-PDF contract test (signed GET)
# PDF_STAGING_FILES=
# PDF_STAGING_URLS=
# PDF_MIN_PAGES=
# APPIUM_HOME=~/.liskov-appium/appium-home   # framework-local drivers; never ~/.appium
# APPIUM_PORT=4725               # 4725 OnePlus · 4726 iPhone · 4727 emulator. Never 4000/4003/4005/9090
# WDA_LOCAL_PORT=8111

# =====================================================================================================
# [B] SECRETS — test account (required for `npm run login` / `make login`)
# =====================================================================================================
USER1_ROLE=core_digital
USER1_EMAIL=you@example.com
USER1_PASSWORD=change-me

# =====================================================================================================
# [B] SECRETS — app keys. Copy these from mobile-liskov's .env (same key names):
#     grep -E '^(STAGE_)?(DOWNLOAD_HMAC_KEY|AMPLITUDE_API_KEY|AMPLITUDE_PROJECT_API_KEY|AMPLITUDE_SERVER_ZONE|LAMARR_FIREBASE_PROJECT_ID|LAMARR_FIREBASE_API_KEY)=' \
#       ~/Documents/mobile-liskov/.env >> .env
# Only these are read by the framework (config/secrets.ts). Copying the whole mobile-liskov .env also works (the
# extra keys are ignored and never reach process.env), but keep only what you need.
# =====================================================================================================
STAGE_DOWNLOAD_HMAC_KEY=<from mobile-liskov .env>
STAGE_AMPLITUDE_API_KEY=<from mobile-liskov .env>
STAGE_AMPLITUDE_PROJECT_API_KEY=<from mobile-liskov .env>
STAGE_AMPLITUDE_SERVER_ZONE=<from mobile-liskov .env>
STAGE_LAMARR_FIREBASE_PROJECT_ID=<from mobile-liskov .env>
STAGE_LAMARR_FIREBASE_API_KEY=<from mobile-liskov .env>
# ENV=prod only:
# DOWNLOAD_HMAC_KEY=<from mobile-liskov .env>
# AMPLITUDE_API_KEY=<from mobile-liskov .env>
# AMPLITUDE_PROJECT_API_KEY=<from mobile-liskov .env>
# AMPLITUDE_SERVER_ZONE=<from mobile-liskov .env>
# LAMARR_FIREBASE_PROJECT_ID=<from mobile-liskov .env>
# LAMARR_FIREBASE_API_KEY=<from mobile-liskov .env>
# Other accounts stay 1Password references in config/accounts.ts (op://Automation/…); unattended runs only:
# OP_SERVICE_ACCOUNT_TOKEN=<1Password service-account token — never commit>

# =====================================================================================================
# [C] PER-RUN KNOBS — export in the shell (NOT read from .env). Reference only.
# =====================================================================================================
# ANDROID_SERIAL=emulator-5554 | <adb serial>   IOS_UDID=<device udid>   UIA2_SYSTEM_PORT=8213   APP_USER_ID=0
# ANDROID_SPECS=./specs/epaper/ep03-*.spec.ts   IOS_SPECS=…   ALLURE_DIR=allure-results   EVIDENCE_DIR=reports/evidence
# SUITE_DIR=reports/suite   SPEC_TIMEOUT=1200   WDIO_LOG_LEVEL=warn   ADB=~/Library/Android/sdk/platform-tools/adb
# Login script: LOGIN_ACCOUNT=user1  LOGIN_RELOGIN=1|0  LOGIN_SETTLE_MS=6000  LOGIN_LOG_DIR=reports/login
# Gate opt-ins ("1" = on): DEVICE_DEDICATED ALLOW_OFFLINE ALLOW_THROTTLE ALLOW_HEAVY HAS_SIM_ONLY_NETWORK IS_IPAD IS_TABLET
# Start state: PRESERVE_OWNER_DOWNLOADS=1 (never delete an already-downloaded edition)  REDOWNLOAD_WATCH_MS=10000  RESTORE_OWN
# iOS guard: BANNER_WAIT_MS=8000  FRONT_AFTER_MS=1500  TOP_SETTLE_MS=1500  WDA_REBUILD   UI_TIMEOUT_MS
# scripts/dev/ explore tools: EXPLORE_STEPS EXPLORE_DIR EXPLORE_TAP_MS OUT
